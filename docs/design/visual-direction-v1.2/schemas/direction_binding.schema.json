{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmontage:schema:direction_binding",
  "title": "Direction Execution Binding — v1.2",
  "description": "Generated by bind() at compose time, never hand-written: for every contract action, where it executes (production scene, runtime, seconds, timeline events) and which authored code implements each of those events. Implementation refs come from the existing traces (binding/remotion_source.build_trace for atelier source, binding/hyperframes.trace_workspace for HyperFrames scenes, the generic renderer for templated visual_model cuts), normalized here to one shape. Copying an id is never proof of implementation: an action is 'bound' only when every event it owns has at least one implementation ref.",
  "type": "object",
  "required": ["version", "contract_fingerprint", "timeline_sha256", "actions", "events"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": "1.2"},
    "contract_fingerprint": {"$ref": "urn:openmontage:schema:direction_common#/$defs/fingerprint"},
    "timeline_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action_id", "status", "event_ids"],
        "additionalProperties": false,
        "properties": {
          "action_id": {"$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id"},
          "status": {"enum": ["bound", "unbound", "deviated"]},
          "production_scene_id": {"type": "string"},
          "runtime": {"$ref": "#/$defs/runtime"},
          "event_ids": {"type": "array", "items": {"type": "string"}},
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "minimum": 0},
          "from_state_id": {"$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id"},
          "to_state_id": {"$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id"},
          "implementation_refs": {"type": "array", "items": {"$ref": "#/$defs/implementation_ref"}},
          "deviation_id": {"type": "string"}
        }
      }
    },
    "events": {
      "type": "array",
      "description": "Normalized trace: one row per timeline event, whatever runtime executed it.",
      "items": {
        "type": "object",
        "required": ["event_id", "runtime", "implemented", "refs"],
        "additionalProperties": false,
        "properties": {
          "event_id": {"type": "string"},
          "action_id": {"$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id"},
          "runtime": {"$ref": "#/$defs/runtime"},
          "time_seconds": {"type": "number", "minimum": 0},
          "implemented": {"type": "boolean"},
          "refs": {"type": "array", "items": {"$ref": "#/$defs/implementation_ref"}}
        }
      }
    },
    "trace_sources": {
      "type": "array",
      "description": "Raw traces the rows were normalized from, for audit.",
      "items": {
        "type": "object",
        "required": ["runtime", "source"],
        "additionalProperties": false,
        "properties": {
          "runtime": {"$ref": "#/$defs/runtime"},
          "source": {"type": "string", "description": "project dir or HyperFrames workspace"},
          "hard_failures": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "$defs": {
    "runtime": {"enum": ["remotion_atelier", "remotion_templated", "hyperframes"]},
    "implementation_ref": {
      "type": "object",
      "required": ["file", "line", "via"],
      "additionalProperties": false,
      "properties": {
        "file": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "symbol": {"type": "string", "description": "enclosing component/function"},
        "via": {"type": "string", "description": "how the code consumes the event: useEventProgress, useElement, useModelState, DirectionElement, OM.at, data-om-event, generic_renderer"}
      }
    }
  }
}
