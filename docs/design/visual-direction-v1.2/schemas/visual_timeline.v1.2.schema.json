{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmontage:schema:visual_timeline_v1_2",
  "title": "Visual Timeline (v1.0 or v1.2)",
  "description": "Execution contract compiled from visual_direction and the forced-aligned narration: each beat becomes an event at a real time. Renderers execute these events; they do not reinterpret scene descriptions.",
  "type": "object",
  "required": [
    "version",
    "models",
    "events",
    "unmatched"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "1.0",
        "1.2"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Paths of the visual_direction and alignment files this timeline was compiled from."
    },
    "models": {
      "type": "array",
      "description": "v1.0: copied from visual_direction.visual_models. v1.2: copied from persistent_visual_models (definition of every model the timeline uses).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "initial_state"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "renderer": {
            "type": "string",
            "enum": [
              "generic",
              "bespoke"
            ]
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "beat_id",
          "scene_id",
          "model_id",
          "operation",
          "target",
          "time_seconds",
          "duration_seconds",
          "anchor"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "beat_id": {
            "type": "string"
          },
          "scene_id": {
            "type": "string"
          },
          "model_id": {
            "type": "string"
          },
          "operation": {
            "type": "string",
            "enum": [
              "ADD",
              "REMOVE",
              "REVEAL",
              "CONNECT",
              "EXPAND",
              "SHIFT",
              "PROPAGATE",
              "MEASURE"
            ]
          },
          "target": {
            "type": "string"
          },
          "params": {
            "type": "object"
          },
          "time_seconds": {
            "type": "number",
            "minimum": 0
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "takeaway": {
            "type": [
              "string",
              "null"
            ]
          },
          "anchor": {
            "type": "object",
            "required": [
              "text",
              "start_seconds",
              "end_seconds",
              "score"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "matched_text": {
                "type": "string"
              },
              "start_seconds": {
                "type": "number"
              },
              "end_seconds": {
                "type": "number"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "action_id": {
            "$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id",
            "description": "v1.2: contract action this operation implements (an action may span several operations)."
          },
          "state_after_id": {
            "$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id",
            "description": "v1.2: contract state that must hold once this operation's sync group has applied."
          },
          "contract_event_id": {
            "$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id",
            "description": "v1.2: contract event (time group) this belongs to."
          },
          "anchor_id": {
            "$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id",
            "description": "v1.2: contract anchor whose exact text this beat uses as narration_anchor."
          },
          "sync_group": {
            "type": "string",
            "description": "v1.2: operations forming one change: same resolved start and duration; invariants are checked after the whole group."
          }
        }
      }
    },
    "tool_layers": {
      "type": "object",
      "description": "Per-scene tool selection copied from tool_plan so the execution contract keeps which tools fill each scene.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "role",
            "need",
            "offer",
            "tool"
          ],
          "properties": {
            "role": {
              "type": "string"
            },
            "need": {
              "type": "string"
            },
            "offer": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            }
          }
        }
      }
    },
    "unmatched": {
      "type": "array",
      "description": "Beats whose anchor was not found in the aligned narration. Must be empty before compose.",
      "items": {
        "type": "object",
        "required": [
          "beat_id",
          "narration_anchor",
          "reason"
        ],
        "properties": {
          "beat_id": {
            "type": "string"
          },
          "scene_id": {
            "type": "string"
          },
          "narration_anchor": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    },
    "contract": {
      "$ref": "urn:openmontage:schema:direction_common#/$defs/contract_ref"
    },
    "anchor_resolution": {
      "type": "object",
      "required": [
        "resolved_anchors",
        "unresolved_anchors"
      ],
      "additionalProperties": false,
      "description": "v1.2 (original §26): every contract anchor resolved against the forced alignment.",
      "properties": {
        "source_word_count": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_anchors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "anchor_id",
              "status",
              "start_time",
              "end_time"
            ],
            "additionalProperties": false,
            "properties": {
              "anchor_id": {
                "$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id"
              },
              "source_text": {
                "type": "string"
              },
              "word_ids": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "start_time": {
                "type": "number",
                "minimum": 0
              },
              "end_time": {
                "type": "number",
                "minimum": 0
              },
              "start_frame": {
                "type": "integer",
                "minimum": 0
              },
              "end_frame": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "enum": [
                  "EXACT",
                  "REVERSIBLE_NORMALIZATION",
                  "FUZZY"
                ]
              },
              "same_span": {
                "type": "boolean",
                "description": "false = resolved to different words than the contract span: a deviation for a locked anchor"
              }
            }
          }
        },
        "unresolved_anchors": {
          "type": "array",
          "items": {
            "$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id"
          }
        }
      }
    }
  }
}
