{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmontage:schema:direction_lineage",
  "title": "Direction Lineage — v1.2",
  "description": "Scene-stage crosswalk written by the planner: which production scenes (scene_plan ids) carry which Director contract ids. A separate artifact because the upstream scene_plan schema forbids extra fields. The planner may split or merge Director scenes; it may not drop, rename or re-decide a locked id. check_lineage() verifies coverage against the contract and against visual_direction beats.",
  "type": "object",
  "required": ["version", "contract_fingerprint", "production_scenes"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": "1.2"},
    "contract_fingerprint": {"$ref": "urn:openmontage:schema:direction_common#/$defs/fingerprint"},
    "production_scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "source_scene_ids"],
        "additionalProperties": false,
        "properties": {
          "scene_id": {"type": "string", "description": "scene_plan.scenes[].id"},
          "source_scene_ids": {"type": "array", "items": {"$ref": "urn:openmontage:schema:direction_common#/$defs/scene_id"}, "minItems": 1},
          "split": {
            "type": "object",
            "required": ["part", "of"],
            "additionalProperties": false,
            "description": "This production scene is part N of M of one Director scene.",
            "properties": {"part": {"type": "integer", "minimum": 1}, "of": {"type": "integer", "minimum": 1}}
          },
          "source_beat_ids": {"type": "array", "items": {"$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id"}},
          "source_state_ids": {"type": "array", "items": {"$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id"}},
          "source_action_ids": {"type": "array", "items": {"$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id"}},
          "source_invariant_ids": {"type": "array", "items": {"$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id"}},
          "source_pvm_ids": {"type": "array", "items": {"$ref": "urn:openmontage:schema:direction_common#/$defs/model_ref"}},
          "runtime": {"enum": ["remotion", "hyperframes", "footage", "inherit"], "description": "Mirror of scene_plan.scenes[].runtime for review; scene_plan stays the authority."}
        }
      }
    },
    "unassigned": {
      "type": "array",
      "description": "Contract ids the planner could not place. Each needs an open deviation; completion is blocked until it is resolved.",
      "items": {
        "type": "object",
        "required": ["id", "deviation_id"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id"},
          "deviation_id": {"type": "string"}
        }
      }
    }
  }
}
