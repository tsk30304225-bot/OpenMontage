{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmontage:schema:execution_binding",
  "title": "Execution Binding (43) — v1.2",
  "description": "Generated by bind() at compose time, never hand-written. For every locked contract action: where it executes and, for EVERY runtime layer of the contract's runtime_stack that declared it in `consumes`, which authored code implements it. The schema is multi-runtime even though the current engine renders one primary runtime per scene. Implementation refs come from the existing traces (atelier source scan, HyperFrames OM.at scan, generic renderer), normalized to one shape. An action is 'bound' only when every declaring layer is bound; copying an id is never proof.",
  "type": "object",
  "required": [
    "version",
    "contract",
    "timeline_sha256",
    "actions",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.2"
    },
    "contract": {
      "$ref": "urn:openmontage:schema:direction_common#/$defs/contract_ref"
    },
    "timeline_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action_id",
          "status",
          "event_ids",
          "layer_bindings"
        ],
        "additionalProperties": false,
        "properties": {
          "action_id": {
            "$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id"
          },
          "status": {
            "enum": [
              "bound",
              "unbound",
              "deviated"
            ],
            "description": "bound = every declaring layer bound; deviated = an APPROVED deviation covers the missing layers"
          },
          "production_scene_id": {
            "type": "string"
          },
          "event_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "minimum": 0
          },
          "from_state_id": {
            "$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id"
          },
          "to_state_id": {
            "$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id"
          },
          "deviation_id": {
            "type": "string"
          },
          "consumes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event_ids": {
                "type": "array",
                "items": {
                  "$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id"
                },
                "description": "contract events"
              },
              "state_ids": {
                "type": "array",
                "items": {
                  "$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id"
                }
              }
            }
          },
          "produces": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "timeline operation event ids that executed it"
          },
          "layer_bindings": {
            "type": "array",
            "description": "one row per runtime_stack layer whose consumes lists this action (or its events/states)",
            "items": {
              "type": "object",
              "required": [
                "layer",
                "runtime",
                "status",
                "implementation_refs"
              ],
              "additionalProperties": false,
              "properties": {
                "layer": {
                  "$ref": "#/$defs/layer"
                },
                "runtime": {
                  "$ref": "#/$defs/runtime"
                },
                "status": {
                  "enum": [
                    "bound",
                    "unbound",
                    "deviated",
                    "not_executed_by_engine"
                  ],
                  "description": "not_executed_by_engine: the layer is declared but the current engine has no path to run it — counts as unbound for a locked id"
                },
                "implementation_path": {
                  "type": "string"
                },
                "component_or_block": {
                  "type": "string"
                },
                "implementation_refs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/implementation_ref"
                  }
                },
                "deviation_id": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "description": "Normalized trace: one row per visual_timeline operation event, whatever runtime executed it (atelier source scan, HyperFrames OM.at scan, generic renderer).",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "runtime",
          "implemented",
          "refs"
        ],
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "type": "string"
          },
          "action_id": {
            "$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id"
          },
          "runtime": {
            "$ref": "#/$defs/runtime"
          },
          "time_seconds": {
            "type": "number",
            "minimum": 0
          },
          "implemented": {
            "type": "boolean"
          },
          "refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/implementation_ref"
            }
          },
          "contract_event_id": {
            "$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id"
          },
          "layer": {
            "$ref": "#/$defs/layer"
          }
        }
      }
    },
    "trace_sources": {
      "type": "array",
      "description": "Raw traces the rows were normalized from, for audit.",
      "items": {
        "type": "object",
        "required": [
          "runtime",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "runtime": {
            "$ref": "#/$defs/runtime"
          },
          "source": {
            "type": "string",
            "description": "project dir or HyperFrames workspace"
          },
          "hard_failures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "runtime": {
      "enum": [
        "remotion_templated",
        "remotion_atelier",
        "hyperframes",
        "footage",
        "generated",
        "audio"
      ]
    },
    "implementation_ref": {
      "type": "object",
      "required": [
        "file",
        "line",
        "via"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": "string",
          "description": "enclosing component/function"
        },
        "via": {
          "type": "string",
          "description": "how the code consumes the event: useEventProgress, useElement, useModelState, DirectionElement, OM.at, data-om-event, generic_renderer"
        }
      }
    },
    "layer": {
      "enum": [
        "base_visual",
        "factual_source",
        "deterministic_graphics",
        "generated_media",
        "character",
        "captions",
        "sound",
        "postprocess",
        "master_composite"
      ]
    }
  }
}