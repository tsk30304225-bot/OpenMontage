{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmontage:schema:execution_binding",
  "title": "Execution Binding (43) — v1.2",
  "description": "Generated by bind() at compose time, never hand-written (original §18). The canonical unit is a binding: one production scene × one runtime layer of the contract's runtime_stack, the locked contract ids that layer consumes there, and a locator proving where they are realized — authored code (CODE), a source asset placed by an edit_decisions cut (ASSET), or a runtime's own output (RUNTIME_OUTPUT). Every layer that declared a locked id in runtime_stack.consumes gets a binding row; a locked id is bound only when every declaring layer is bound for it. Action, state and event coverage is derived from the bindings, never stored separately. Copying an id is never proof: the locator comes from the traces (atelier source scan, HyperFrames OM.at scan, generic renderer) or from edit_decisions.",
  "type": "object",
  "required": [
    "version",
    "contract",
    "timeline_sha256",
    "scene_windows",
    "bindings",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.2"
    },
    "contract": {
      "$ref": "urn:openmontage:schema:direction_common#/$defs/contract_ref"
    },
    "timeline_sha256": {
      "$ref": "urn:openmontage:schema:direction_common#/$defs/sha256"
    },
    "edit_decisions_sha256": {
      "$ref": "urn:openmontage:schema:direction_common#/$defs/sha256"
    },
    "scene_windows": {
      "type": "array",
      "description": "Program-time window of every production scene as rendered, derived by bind() from edit_decisions: primary-layer cuts in order, each lasting (out_seconds - in_seconds) / speed, the way video_compose builds scenes. The scene end used by ACTIVE_AT_SCENE_END, LAST_FRAME and minimum_hold (README 6-1).",
      "items": {
        "type": "object",
        "required": [
          "production_scene_id",
          "start_seconds",
          "end_seconds",
          "cut_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "production_scene_id": {
            "type": "string"
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "minimum": 0
          },
          "cut_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "events": {
      "type": "array",
      "description": "Normalized trace: one row per visual_timeline operation event, whatever runtime executed it. Audit detail for CODE bindings.",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "runtime",
          "implemented",
          "refs"
        ],
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "type": "string"
          },
          "production_scene_id": {
            "type": "string"
          },
          "action_id": {
            "$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id"
          },
          "contract_event_id": {
            "$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id"
          },
          "layer": {
            "$ref": "#/$defs/layer"
          },
          "runtime": {
            "$ref": "#/$defs/runtime"
          },
          "time_seconds": {
            "type": "number",
            "minimum": 0
          },
          "implemented": {
            "type": "boolean"
          },
          "refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/code_ref"
            }
          }
        }
      }
    },
    "trace_sources": {
      "type": "array",
      "description": "Raw traces the rows were normalized from, for audit.",
      "items": {
        "type": "object",
        "required": [
          "layer",
          "runtime",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "layer": {
            "$ref": "#/$defs/layer"
          },
          "runtime": {
            "$ref": "#/$defs/runtime"
          },
          "source": {
            "type": "string",
            "description": "project dir, HyperFrames workspace, or edit_decisions"
          },
          "hard_failures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "ids": {
      "type": "array",
      "items": {
        "$ref": "urn:openmontage:schema:direction_common#/$defs/qualified_id"
      }
    },
    "binding": {
      "type": "object",
      "required": [
        "binding_id",
        "production_scene_id",
        "layer",
        "runtime",
        "consumes",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "type": "string",
          "description": "<production_scene_id>/<layer>"
        },
        "production_scene_id": {
          "type": "string",
          "description": "scene_plan id (the 42 production scene)"
        },
        "layer": {
          "$ref": "#/$defs/layer"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "consumes": {
          "type": "object",
          "additionalProperties": false,
          "description": "Locked contract ids this layer realizes in this production scene: the layer's runtime_stack.consumes intersected with what 42 maps to this production scene.",
          "properties": {
            "action_ids": {
              "$ref": "#/$defs/ids"
            },
            "event_ids": {
              "$ref": "#/$defs/ids",
              "description": "contract events (SC009/E01), not timeline operation events"
            },
            "state_ids": {
              "$ref": "#/$defs/ids"
            }
          },
          "anyOf": [
            {
              "required": [
                "action_ids"
              ],
              "properties": {
                "action_ids": {
                  "minItems": 1
                }
              }
            },
            {
              "required": [
                "event_ids"
              ],
              "properties": {
                "event_ids": {
                  "minItems": 1
                }
              }
            },
            {
              "required": [
                "state_ids"
              ],
              "properties": {
                "state_ids": {
                  "minItems": 1
                }
              }
            }
          ]
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "status": {
          "enum": [
            "bound",
            "unbound",
            "deviated",
            "not_executed_by_engine"
          ],
          "description": "bound = the locator proves every consumed id; unbound = no proof; deviated = an APPROVED deviation covers it; not_executed_by_engine = the layer is declared but the current engine has no path to run it (counts as unbound for a locked id)"
        },
        "timeline_event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "visual_timeline operation events executed by this binding"
        },
        "start_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "where the consumed ids execute (CODE: first operation) or the asset becomes active (ASSET: cut in)"
        },
        "end_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "CODE: last operation end; ASSET: cut out"
        },
        "deviation_id": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "bound"
              }
            }
          },
          "then": {
            "required": [
              "locator"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "deviated"
              }
            }
          },
          "then": {
            "required": [
              "deviation_id"
            ]
          }
        }
      ]
    },
    "locator": {
      "description": "Where the consumed ids are realized. Discriminated by kind.",
      "oneOf": [
        {
          "$ref": "#/$defs/code_locator"
        },
        {
          "$ref": "#/$defs/asset_locator"
        },
        {
          "$ref": "#/$defs/runtime_output_locator"
        }
      ]
    },
    "code_locator": {
      "type": "object",
      "required": [
        "kind",
        "implementation_path",
        "refs"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "CODE"
        },
        "implementation_path": {
          "type": "string",
          "description": "project dir or workspace whose authored code consumes the ids"
        },
        "component_or_block": {
          "type": "string"
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/code_ref"
          }
        }
      }
    },
    "asset_locator": {
      "type": "object",
      "required": [
        "kind",
        "cut_id",
        "source_asset_ref",
        "via"
      ],
      "additionalProperties": false,
      "description": "A source asset placed by an edit_decisions cut. No line number: an asset has none.",
      "properties": {
        "kind": {
          "const": "ASSET"
        },
        "cut_id": {
          "type": "string"
        },
        "source_asset_ref": {
          "type": "string",
          "description": "the cut's source as written in edit_decisions (path or asset-manifest id)"
        },
        "via": {
          "type": "string",
          "description": "e.g. edit_decisions.cut"
        },
        "in_seconds": {
          "type": "number",
          "minimum": 0
        },
        "out_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "runtime_output_locator": {
      "type": "object",
      "required": [
        "kind",
        "runtime_output_ref",
        "via"
      ],
      "additionalProperties": false,
      "description": "A runtime's own rendered output (e.g. a HyperFrames scene clip, a generated media file) when no authored code or placed asset is the proof.",
      "properties": {
        "kind": {
          "const": "RUNTIME_OUTPUT"
        },
        "runtime_output_ref": {
          "type": "string"
        },
        "via": {
          "type": "string"
        },
        "sha256": {
          "$ref": "urn:openmontage:schema:direction_common#/$defs/sha256"
        }
      }
    },
    "code_ref": {
      "type": "object",
      "required": [
        "file",
        "via"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": "string",
          "description": "enclosing component/function"
        },
        "via": {
          "type": "string",
          "description": "how the code consumes the event: useEventProgress, useElement, useModelState, DirectionElement, OM.at, data-om-event, generic_renderer"
        }
      }
    },
    "runtime": {
      "enum": [
        "remotion_templated",
        "remotion_atelier",
        "hyperframes",
        "footage",
        "generated",
        "audio"
      ]
    },
    "layer": {
      "enum": [
        "base_visual",
        "factual_source",
        "deterministic_graphics",
        "generated_media",
        "character",
        "captions",
        "sound",
        "postprocess",
        "master_composite"
      ]
    }
  }
}
